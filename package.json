{
  "name": "soc-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Soc_brain monorepo. Artifact target: @soc/project-registry (Issue #17).",
  "scripts": {
    "test": "node --test tests/review-payload.test.mjs tests/review-evidence.test.mjs tests/soc-score.test.mjs tests/control-loop-gemini-web2api-copy.test.mjs tests/control-loop-commit-recovery.test.mjs",
    "test:ui": "node tests/ui-view-model.test.mjs && node tests/control-ui.test.mjs",
    "build:project-registry": "node scripts/build-package.mjs",
    "test:fast": "node --test tests/review-payload.test.mjs tests/review-evidence.test.mjs tests/soc-score.test.mjs tests/control-loop-commit-recovery.test.mjs",
    "test:gate": "node --test tests/review-payload.test.mjs tests/review-evidence.test.mjs tests/soc-score.test.mjs tests/control-loop-gemini-web2api-copy.test.mjs tests/cdp-supervisor.test.mjs tests/control-loop-commit-recovery.test.mjs",
    "test:all": "node --test 'tests/*.test.mjs'",
    "gate:tier": "node scripts/run-tier.mjs --gate",
    "gate:tier:list": "node scripts/run-tier.mjs --gate --list",
    "test:t1": "node scripts/run-tier.mjs --tier t1",
    "test:t2": "node scripts/run-tier.mjs --tier t2",
    "test:t3": "node scripts/run-tier.mjs --tier t3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
