{
  "name": "soc-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Soc_brain monorepo. Artifact target: @soc/project-registry (Issue #17).",
  "scripts": {
    "test": "node scripts/run-tier-tests.mjs t0",
    "test:ui": "node tests/ui-view-model.test.mjs && node tests/control-ui.test.mjs",
    "build:project-registry": "node scripts/build-package.mjs",
    "test:gate": "node --test tests/review-payload.test.mjs tests/review-evidence.test.mjs tests/soc-score.test.mjs tests/control-loop-gemini-web2api-copy.test.mjs tests/cdp-supervisor.test.mjs tests/control-loop-commit-recovery.test.mjs",
    "test:all": "node --test 'tests/*.test.mjs'",
    "gate:tier": "node scripts/run-tier.mjs --gate",
    "gate:tier:list": "node scripts/run-tier.mjs --gate --list",
    "test:t1": "node scripts/run-tier-tests.mjs t1",
    "test:t2": "node scripts/run-tier-tests.mjs t2",
    "test:t3": "node scripts/run-tier-tests.mjs t3",
    "test:core": "node scripts/run-tier.mjs --tier t1 && node scripts/run-tier.mjs --tier t2",
    "test:mcp": "node --test tests/*mcp*.test.mjs tests/execution-broker*.test.mjs tests/mutation-ownership.test.mjs",
    "test:fast": "node scripts/run-tier-tests.mjs t1",
    "test:integration": "node scripts/run-tier-tests.mjs t2",
    "test:heavy": "node scripts/run-tier-tests.mjs t3",
    "test:all-tiers": "node scripts/run-tier-tests.mjs all",
    "test:smoke": "node scripts/run-tier-tests.mjs t0",
    "test:t0": "node scripts/run-tier-tests.mjs t0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
