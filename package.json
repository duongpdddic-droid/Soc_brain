{
  "name": "soc-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Soc_brain monorepo. Artifact target: @soc/project-registry (Issue #17).",
  "scripts": {
    "test": "node --test tests/review-payload.test.mjs tests/soc-score.test.mjs tests/control-loop-gemini-web2api-copy.test.mjs",
