    "build:project-registry": "node scripts/build-package.mjs",
    "test:fast": "node --test tests/review-payload.test.mjs tests/soc-score.test.mjs",
    "test:gate": "node --test tests/review-payload.test.mjs tests/soc-score.test.mjs tests/control-loop-gemini-web2api-copy.test.mjs tests/cdp-supervisor.test.mjs",
    "test:all": "node --test 'tests/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
