{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duongpdddic-droid.github.io/AI_PR_REVIEWER/schemas/project-manifest-1.0.json",
  "title": "AI_PR_REVIEWER Project Manifest",
  "description": "Versioned schema cho .agent/project.json — định danh/capability canonical của mỗi project (Issue #14). Fail-closed: thiếu repo identity -> reject. Không chứa secret/absolute path.",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "repository",
    "projectType",
    "workspace",
    "policy",
    "verify",
    "deploy",
    "telegram",
    "memory"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version schema, ví dụ 1.0. < MIN_SCHEMA_VERSION -> cần migrate."
    },
    "projectId": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[\\w.-]+/[\\w.-]+$",
      "description": "Repo identity owner/name — canonical, bắt buộc."
    },
    "projectType": {
      "type": "string",
      "enum": ["control-plane", "product", "adapter"]
    },
    "workspace": {
      "type": "object",
      "required": ["workspaceId"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "pin": { "type": "string" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "verify": {
      "type": "object",
      "required": ["adapter"],
      "properties": { "adapter": { "type": "string", "minLength": 1 } }
    },
    "deploy": {
      "type": "object",
      "required": ["humanAuthorization"],
      "properties": {
        "capability": { "type": "boolean" },
        "humanAuthorization": { "type": "boolean" }
      }
    },
    "telegram": {
      "type": "object",
      "required": ["route"],
      "properties": { "route": { "type": "string", "minLength": 1 } }
    },
    "memory": {
      "type": "object",
      "required": ["provider", "namespace"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "allowedOverrides": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["policy", "verifyAdapter", "telegramRoute", "deploy.humanAuthorization"]
      }
    }
  }
}
