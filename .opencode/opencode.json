{
  "$schema": "https://opencode.ai/schema.json",
  "permission": {
    "external_directory": "allow",
    "read": "allow",
    "write": "allow",
    "terminal": "allow",
    "bash": {
      "*": "allow",
      "git update-ref *": "deny",
      "git branch -f main*": "deny"
    }
  },
  "mcp": {
    "soc-brain-gateway": {
      "type": "local",
      "command": [
        "node",
        "packages/client-mcp/gateway-mcp.mjs"
      ],
      "environment": {
        "SOC_CONTROL_LANE": "opencode-control-lane",
        "SOC_GATEWAY_FULL_LOOP": "1"
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Build executor with full worktree access",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "terminal": "allow"
      }
    },
    "soc_control": {
      "mode": "primary",
      "description": "Soc Control orchestrator and loop manager",
      "permission": {
        "*": "allow",
        "external_directory": "allow",
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "terminal": "allow",
        "soc-brain-gateway_gateway": "allow"
      }
    },
    "soc_review": {
      "mode": "all",
      "description": "Independent candidate reviewer and verifier",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.pem": "deny",
          "*.key": "deny",
          "*.pfx": "deny",
          "*.p12": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "allow",
        "write": "deny",
        "edit": "deny",
        "task": "deny"
      }
    },
    "soc_build": {
      "mode": "subagent",
      "description": "Soc Build executor with full worktree access under soc_control",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "terminal": "allow"
      }
    }
  }
}
