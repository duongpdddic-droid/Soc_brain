{
  "$schema": "https://opencode.ai/schema.json",
  "permission": {
    "external_directory": "allow",
    "read": "allow",
    "write": "allow",
    "terminal": "allow"
  },
  "agents": {
    "build": {
      "model": "gpt-6.1-sol-fast",
      "mode": "primary",
      "description": "Build executor with full worktree access",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "terminal": "allow"
      }
    },
    "soc_control": {
      "model": "gpt-6.1-sol",
      "mode": "subagent",
      "description": "Soc Control orchestrator and loop manager",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "terminal": "allow"
      }
    },
    "soc_review": {
      "model": "gpt-6.1-sol",
      "mode": "subagent",
      "description": "Independent candidate reviewer and verifier",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "deny",
        "terminal": "allow"
      }
    }
  }
}